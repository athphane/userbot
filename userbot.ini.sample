[pyrogram]
api_id = 123456
api_hash = your-hash

; Optional. Relative paths are resolved from the bot's working directory.
[database]
path = config/userbot.sqlite3

[pm_permit]
pm_permit = false
pm_limit = 5

[logs]
log_group = None

[yandex]
key = your-key-but-Yandex-no-longer-gives

[misc]
yourls_url = http://your-domain.test/yourls-api.php
yourls_key = your key here

[spotify]
username =
client_id =
client_secret =

[proxy]
socks5_proxy = socks5://username:password@ip-address:port

[social_dl]
; Enable downloads from other group members and permitted private chats.
enabled = false
; Numeric Telegram group ID, for example -1001234567890.
allowed_group = 0
; Comma-separated Telegram user IDs to ignore for group auto-downloads.
ignored_users =
